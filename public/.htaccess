Options -Indexes
DirectoryIndex index.html
RewriteEngine On

<FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# API requests are routed by public/api/.htaccess.
RewriteRule ^api/ - [L]

# Keep static frontend routes compatible with the original pages.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^$ index.html [L]